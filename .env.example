# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_DB=pillarsquare
POSTGRES_USER=pillarsquare
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://pillarsquare:changeme_strong_password@db:5432/pillarsquare

# ── Backend / FastAPI ──────────────────────────────────────────────────────────
SECRET_KEY=changeme_very_long_random_secret_key_here
DEBUG=false
ALLOWED_ORIGINS=https://example.com,https://www.example.com
BACKEND_CORS_ORIGINS=["https://example.com"]

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_strong_admin_password

# ── Telegram / Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# ── n8n Webhook ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-secret-here

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://example.com/api

# ── Uploads ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Domain & SSL ───────────────────────────────────────────────────────────────
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
